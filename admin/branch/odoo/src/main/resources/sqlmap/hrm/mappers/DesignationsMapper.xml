  <sql id="pageable">
    <if test="pageable.sort.sorted">
      <trim prefix="order by">
        <foreach item="order" index="i" collection="pageable.sort" separator=", ">
          <if test="order.property == 'designateid'">designateid ${order.direction}</if>
          <if test="order.property == 'employeeid'">employeeid ${order.direction}</if>
          <if test="order.property == 'unitid'">unitid ${order.direction}</if>
