          <if test="order.property == 'jobtitleid'">jobtitleid ${order.direction}</if>
          <if test="order.property == 'designatestatusid'">designatestatusid ${order.direction}</if>
        </foreach>
      </trim>
    </if>
    <if test="pageable.paged">
      limit #{pageable.pageSize} offset #{pageable.offset}
    </if>
  </sql>

  <sql id="searchCondition">
    <if test="search != null">
      <if test="search.designateid != null"> and designateid = #{search.designateid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}</if>
      <if test="search.employeeid != null"> and employeeid = #{search.employeeid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}</if>
      <if test="search.unitid != null"> and unitid = #{search.unitid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}</if>
      <if test="search.designateunitid != null"> and designateunitid = #{search.designateunitid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}</if>
      <if test="search.effectivedate != null"> and effectivedate = #{search.effectivedate,jdbcType=DATE}</if>

      <if test="search.designatenumber != null">
        <choose>
          <when test='exact == true'>
            and designatenumber = #{search.designatenumber}
          </when>
          <otherwise>
            and designatenumber ILIKE '%${search.designatenumber}%'
          </otherwise>
        </choose>
      </if>
      <if test="search.jobtitleid != null"> and jobtitleid = #{search.jobtitleid}</if>
      <if test="search.designatestatusid != null"> and designatestatusid = #{search.designatestatusid}</if>
    </if>
  </sql>

  <sql id="queryAndCountWhereStatement">
    <where>
      <include refid="searchCondition"></include>
    </where>
  </sql>

  <select id="findById" resultType="com.base.admin.hrm.dto.DesignationsDTO">
<!--    select-->
<!--    <include refid="DTO_Column_List" />-->
<!--    from designations-->
    WITH designations_CTE AS (
        SELECT
          ds.designateid,
          ds.employeeid,
          ds.unitid,
          ds.designateunitid,
          ds.effectivedate,
          ds.designatenumber,
          ds.jobtitleid,
          ds.designatestatusid
        FROM
            designations ds
        where ds.designateid = #{designateid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
    )
    SELECT
      ds.designateid,
      ds.employeeid,
      ds.unitid,
      ds.designateunitid,
      ds.effectivedate,
      ds.designatenumber,
      ds.jobtitleid,
      ds.designatestatusid,
      e.employeecode,
      e.fullname,
      u.unitname,
      ud.unitname as designateunitname,
      jt.jobtitlename
    FROM
      designations_CTE ds
      LEFT JOIN employees e on e.employeeid = ds.employeeid
      LEFT JOIN units u on u.unitid =  ds.unitid
      LEFT JOIN units ud on ud.unitid = ds.designateunitid
      LEFT JOIN job_title jt on jt.jobtitleid = ds.jobtitleid
  </select>

  <select id="countPaged" resultType="java.lang.Long">
    select count(1)
    from designations
    <include refid="queryAndCountWhereStatement"/>
  </select>

