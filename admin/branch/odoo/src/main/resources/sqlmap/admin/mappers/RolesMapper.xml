	<select id="countByListRoleId" parameterType="java.util.List" resultType="java.lang.Long">
		SELECT
		count(1)
		FROM roles
		WHERE roleid IN
		<foreach item="item" index="index" collection="list" open="(" separator="," close=")">
			#{item,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
		</foreach>
	</select>

	<delete id="deleteById" parameterType="java.util.UUID">
		delete from roles
		where roleid = #{roleid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
	</delete>
	<insert id="insert" parameterType="com.base.admin.entity.Roles">
		insert into roles (roleid, organizationid, rolename,
		description, roletype, createdate,
		modifieddate, userupdate, active
		)
		values (#{roleid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
		#{organizationid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
		#{rolename,jdbcType=VARCHAR},
		#{description,jdbcType=VARCHAR}, #{roletype,jdbcType=INTEGER}, #{createdate,jdbcType=TIMESTAMP},
		#{modifieddate,jdbcType=TIMESTAMP}, #{userupdate,jdbcType=VARCHAR}, #{active,jdbcType=BOOLEAN}
		)
	</insert>

	<update id="update" parameterType="com.base.admin.entity.Roles">
		update roles
		set organizationid =
		#{organizationid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
		rolename = #{rolename,jdbcType=VARCHAR},
		description = #{description,jdbcType=VARCHAR},
		roletype = #{roletype,jdbcType=INTEGER},
		createdate = #{createdate,jdbcType=TIMESTAMP},
		modifieddate = #{modifieddate,jdbcType=TIMESTAMP},
		userupdate = #{userupdate,jdbcType=VARCHAR},
		active = #{active,jdbcType=BOOLEAN}
		where roleid = #{roleid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
	</update>

</mapper>