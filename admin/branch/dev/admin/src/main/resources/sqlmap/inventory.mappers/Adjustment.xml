<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.base.admin.inventory.mapper.AdjustmentRepository">
    <resultMap id="BaseResultMap" type="com.base.admin.inventory.entity.Adjustment">
        <id column="id" jdbcType="VARCHAR" property="id" />
        <result column="adjustmentid" jdbcType="VARCHAR" property="adjustmentid" />
        <result column="adjustmentdate" jdbcType="TIMESTAMP" property="adjustmentdate" />
        <result column="adjustmentnumber" jdbcType="VARCHAR" property="adjustmentnumber" />
        <result column="warehouseid" jdbcType="VARCHAR" property="warehouseid" />
        <result column="status" jdbcType="DOUBLE" property="status" />
        <result column="note" jdbcType="VARCHAR" property="note" />
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM adjustment WHERE adjustmentid = #{id}
    </select>
</mapper>