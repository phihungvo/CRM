  <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.base.admin.inventory.entity.ProductAttribute" useGeneratedKeys="true">
    insert into "product_attribute"
    <trim prefix="(" suffix=")" suffixOverrides=",">
