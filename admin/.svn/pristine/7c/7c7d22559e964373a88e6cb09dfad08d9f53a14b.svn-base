  <delete id="deleteByPrimaryKey" parameterType="java.util.UUID">
    delete from "product_attribute"
    where id = #{id,jdbcType=OTHER}
  </delete>
  <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.base.admin.inventory.entity.ProductAttribute" useGeneratedKeys="false">
