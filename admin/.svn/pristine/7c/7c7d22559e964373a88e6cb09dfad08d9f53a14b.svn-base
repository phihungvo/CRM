<mapper namespace="com.base.admin.inventory.mapper.ProductAttributeMapper">
  <resultMap id="BaseResultMap" type="com.base.admin.inventory.entity.ProductAttribute">
    <id column="id" jdbcType="INTEGER" property="id" />
