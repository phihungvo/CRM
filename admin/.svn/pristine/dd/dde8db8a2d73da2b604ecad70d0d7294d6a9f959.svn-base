    </trim>
  </insert>
  <update id="updateByPrimaryKeySelective" parameterType="com.base.admin.hrm.entity.UnitLevel">
    update unit_level
    <set>
      <if test="level != null">
        "level" = #{level,jdbcType=INTEGER},
      </if>
      <if test="unitlevelname != null">
        unitlevelname = #{unitlevelname,jdbcType=VARCHAR},
      </if>
      <if test="position != null">
        "position" = #{position,jdbcType=INTEGER},
      </if>
      <if test="isFavorite != null">
        is_favorite = #{isFavorite,jdbcType=BOOLEAN},
      </if>
      <if test="isSystem != null">
        is_system = #{isSystem,jdbcType=BOOLEAN},
      </if>
    </set>
    where unitlevelid = #{unitlevelid,jdbcType=INTEGER}
  </update>
  <update id="updateByPrimaryKey" parameterType="com.base.admin.hrm.entity.UnitLevel">
    update unit_level
    set "level" = #{level,jdbcType=INTEGER},
      unitlevelname = #{unitlevelname,jdbcType=VARCHAR},
      "position" = #{position,jdbcType=INTEGER},
      is_favorite = #{isFavorite,jdbcType=BOOLEAN},
