      )
    values (#{unitlevelid,jdbcType=INTEGER}, #{level,jdbcType=INTEGER}, #{unitlevelname,jdbcType=VARCHAR}, 
      #{position,jdbcType=INTEGER}, #{isFavorite,jdbcType=BOOLEAN}, #{isSystem,jdbcType=BOOLEAN}
      )
  </insert>
  <insert id="insertSelective" parameterType="com.base.admin.hrm.entity.UnitLevel">
    insert into unit_level
    <trim prefix="(" suffix=")" suffixOverrides=",">
