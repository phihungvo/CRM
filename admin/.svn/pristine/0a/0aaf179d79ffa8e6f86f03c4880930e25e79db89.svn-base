	<select id="countByListUserId" parameterType="java.util.List" resultType="java.lang.Long">
		SELECT
		count(1)
		FROM users
		WHERE userid IN
		<foreach item="item" index="index" collection="list" open="(" separator="," close=")">
			#{item,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
		</foreach>
	</select>

