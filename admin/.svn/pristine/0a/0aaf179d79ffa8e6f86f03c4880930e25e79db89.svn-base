	<insert id="insert" parameterType="com.base.admin.entity.Users">
		insert into users
		(userid, organizationid, username,
		fullname, "password", emailaddress,
		jobtitle, gender, phonenumber,
		passwordencrypted, passwordreset, passwordmodifieddate,
		gracelogincount, languageid, timezoneid,
		logindate, loginip, lastlogindate,
		lastloginip, lastfailedlogindate, failedloginattempts,
		lockout, lockoutdate, usertype,
		createdate, modifieddate, userupdate,
		status)
		values (#{userid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
		#{organizationid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
		#{username,jdbcType=VARCHAR},
		#{fullname,jdbcType=VARCHAR}, #{password,jdbcType=VARCHAR}, #{emailaddress,jdbcType=VARCHAR},
		#{jobtitle,jdbcType=VARCHAR}, #{gender,jdbcType=INTEGER}, #{phonenumber,jdbcType=VARCHAR},
		#{passwordencrypted,jdbcType=BOOLEAN}, #{passwordreset,jdbcType=BOOLEAN},
		#{passwordmodifieddate,jdbcType=TIMESTAMP},
		#{gracelogincount,jdbcType=INTEGER}, #{languageid,jdbcType=VARCHAR}, #{timezoneid,jdbcType=VARCHAR},
		#{logindate,jdbcType=TIMESTAMP}, #{loginip,jdbcType=VARCHAR}, #{lastlogindate,jdbcType=TIMESTAMP},
		#{lastloginip,jdbcType=VARCHAR}, #{lastfailedlogindate,jdbcType=TIMESTAMP},
		#{failedloginattempts,jdbcType=INTEGER},
		#{lockout,jdbcType=BOOLEAN}, #{lockoutdate,jdbcType=TIMESTAMP}, #{usertype,jdbcType=INTEGER},
		#{createdate,jdbcType=TIMESTAMP}, #{modifieddate,jdbcType=TIMESTAMP}, #{userupdate,jdbcType=VARCHAR},
		#{status,jdbcType=INTEGER})
	</insert>

	<delete id="deleteListByIds" parameterType="java.util.List">
		delete from users
		where userid IN
		<foreach item="item" index="index" collection="list" open="(" separator="," close=")">
			#{item,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
		</foreach>
	</delete>

	<update id="update" parameterType="com.base.admin.entity.Users">
		update users
		set
			organizationid = #{organizationid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
			username = #{username,jdbcType=VARCHAR},
			fullname = #{fullname,jdbcType=VARCHAR},
			"password" = #{password,jdbcType=VARCHAR},
			emailaddress = #{emailaddress,jdbcType=VARCHAR},
			jobtitle = #{jobtitle,jdbcType=VARCHAR},
			gender = #{gender,jdbcType=INTEGER},
			phonenumber = #{phonenumber,jdbcType=VARCHAR},
			passwordencrypted = #{passwordencrypted,jdbcType=BOOLEAN},
			passwordreset = #{passwordreset,jdbcType=BOOLEAN},
			passwordmodifieddate = #{passwordmodifieddate,jdbcType=TIMESTAMP},
			gracelogincount = #{gracelogincount,jdbcType=INTEGER},
			languageid = #{languageid,jdbcType=VARCHAR},
			timezoneid = #{timezoneid,jdbcType=VARCHAR},
			logindate = #{logindate,jdbcType=TIMESTAMP},
			loginip = #{loginip,jdbcType=VARCHAR},
			lastlogindate = #{lastlogindate,jdbcType=TIMESTAMP},
			lastloginip = #{lastloginip,jdbcType=VARCHAR},
			lastfailedlogindate = #{lastfailedlogindate,jdbcType=TIMESTAMP},
			failedloginattempts = #{failedloginattempts,jdbcType=INTEGER},
			lockout = #{lockout,jdbcType=BOOLEAN},
			lockoutdate = #{lockoutdate,jdbcType=TIMESTAMP},
			usertype = #{usertype,jdbcType=INTEGER},
			createdate = #{createdate,jdbcType=TIMESTAMP},
			modifieddate = #{modifieddate,jdbcType=TIMESTAMP},
			userupdate = #{userupdate,jdbcType=VARCHAR},
			"status" = #{status,jdbcType=INTEGER}
		where userid = #{userid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
	</update>
</mapper>