	<insert id="saveAll" parameterType="java.util.List">
		insert into users (userid, organizationid, username,
		fullname, password, emailaddress,
		jobtitle, gender, phonenumber,
		passwordencrypted, passwordreset, passwordmodifieddate,
		gracelogincount, languageid, timezoneid,
		logindate, loginip, lastlogindate,
		lastloginip, lastfailedlogindate, failedloginattempts,
		lockout, lockoutdate, usertype,
		createdate, modifieddate, userupdate,
		status)
		values
		<foreach collection="list" item="element" index="index" open="(" separator="),(" close=")">
			#{element.userid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
			#{element.organizationid,jdbcType=OTHER,typeHandler=UUIDTypeHandler},
			#{element.username,jdbcType=VARCHAR},
			#{element.fullname,jdbcType=VARCHAR},
			#{element.password,jdbcType=VARCHAR},
			#{element.emailaddress,jdbcType=VARCHAR},
			#{element.jobtitle,jdbcType=VARCHAR},
			#{element.gender,jdbcType=INTEGER},
			#{element.phonenumber,jdbcType=VARCHAR},
			#{element.passwordencrypted,jdbcType=BOOLEAN},
			#{element.passwordreset,jdbcType=BOOLEAN},
			#{element.passwordmodifieddate,jdbcType=TIMESTAMP},
			#{element.gracelogincount,jdbcType=INTEGER},
			#{element.languageid,jdbcType=VARCHAR},
			#{element.timezoneid,jdbcType=VARCHAR},
			#{element.logindate,jdbcType=TIMESTAMP},
			#{element.loginip,jdbcType=VARCHAR},
			#{element.lastlogindate,jdbcType=TIMESTAMP},
			#{element.lastloginip,jdbcType=VARCHAR},
			#{element.lastfailedlogindate,jdbcType=TIMESTAMP},
			#{element.failedloginattempts,jdbcType=INTEGER},
			#{element.lockout,jdbcType=BOOLEAN},
			#{element.lockoutdate,jdbcType=TIMESTAMP},
			#{element.usertype,jdbcType=INTEGER},
			#{element.createdate,jdbcType=TIMESTAMP},
			#{element.modifieddate,jdbcType=TIMESTAMP},
			#{element.userupdate,jdbcType=VARCHAR},
			#{element.status,jdbcType=INTEGER}
		</foreach>
	</insert>

	<select id="findById" parameterType="java.util.UUID" resultMap="BaseResultMap">
		select
		<include refid="Base_Column_List"/>
		from users
		where userid = #{userid,jdbcType=OTHER,typeHandler=UUIDTypeHandler}
	</select>

