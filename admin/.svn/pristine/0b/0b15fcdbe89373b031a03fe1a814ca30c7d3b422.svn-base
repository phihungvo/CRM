package com.base.admin.inventory.controller;

import java.util.UUID;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.base.admin.handler.ResponseHandler;
import com.base.admin.inventory.dto.request.UomUomDTO;
import com.base.admin.inventory.dto.request.UomUomUpdateDTO;
import com.base.admin.inventory.entity.UomUom;
import com.base.admin.inventory.service.UomUomService;

@RestController
@RequestMapping("/api/v1/inventory/uom-uom")
public class UomUomController {
    private final UomUomService uomUomService;

    public UomUomController(UomUomService uomUomService) {
        this.uomUomService = uomUomService;
    }

    @PostMapping("/findById")
    public ResponseEntity<Object> findById(@RequestParam(name = "uomUomId") UUID id) {
        UomUom uomUom = uomUomService.findById(id);
        if (uomUom == null) {
            ResponseHandler.generateResponseError("Uom uom not found", HttpStatus.NOT_FOUND);
        }
        return ResponseHandler.generateResponseSuccess("", uomUom);
    }

    //    @PostMapping("/search")
    @PostMapping("/create")
    public ResponseEntity<Object> create(@RequestBody UomUomDTO request) {
        int count = uomUomService.create(request);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Failed to add Uom", HttpStatus.INTERNAL_SERVER_ERROR);
        }
        return ResponseHandler.generateResponseSuccess("Uom added successfully", null);
    }

    @PostMapping("/update")
    public ResponseEntity<Object> update(@RequestBody UomUomUpdateDTO request) {
        if (request.getId() == null) {
            return ResponseHandler.generateResponseError(
                    "Invalid parameters. Uom Uom ID not null", HttpStatus.BAD_REQUEST);
        }
        int count = uomUomService.update(request);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Failed to update Uom Uom", HttpStatus.INTERNAL_SERVER_ERROR);
        }
        return ResponseHandler.generateResponseSuccess("Uom Uom updated successfully", null);
    }

    @PostMapping("/delete")
    public ResponseEntity<Object> deleteById(@RequestParam(name = "uomUomId") UUID id) {
        int count = uomUomService.deleteById(id);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Uom Uom not found", HttpStatus.NOT_FOUND);
        }
        return ResponseHandler.generateResponseSuccess("Uom Uom deleted successfully", null);
    }
}
