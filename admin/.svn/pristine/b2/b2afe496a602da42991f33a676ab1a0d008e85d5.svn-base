package com.base.admin.inventory.controller;

import java.util.List;
import java.util.UUID;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.base.admin.handler.ResponseHandler;
import com.base.admin.inventory.dto.request.ResCompanyDTO;
import com.base.admin.inventory.dto.request.ResCompanyUpdateDTO;
import com.base.admin.inventory.entity.ResCompany;
import com.base.admin.inventory.service.ResCompanyService;

@RestController
@RequestMapping("/api/v1/inventory/res-company")
public class ResCompanyController {

    private final ResCompanyService resCompanyService;

    public ResCompanyController(ResCompanyService resCompanyService) {
        this.resCompanyService = resCompanyService;
    }

    @PostMapping("/getAll")
    public ResponseEntity<Object> getAll() {
        List<ResCompany> resCompanies = resCompanyService.getAll();
        if (resCompanies.isEmpty()) {
            return ResponseHandler.generateResponseError("ResCompany not found", HttpStatus.NOT_FOUND);
        }
        return ResponseHandler.generateResponseSuccess("", resCompanies);
    }

    @PostMapping("/create")
    public ResponseEntity<Object> create(@RequestBody ResCompanyDTO resCompanyDTO) {
        int count = resCompanyService.create(resCompanyDTO);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Failed to add res company", null);
        }
        return ResponseHandler.generateResponseSuccess("Res company added successfully", null);
    }

    @PostMapping("/findById")
    public ResponseEntity<Object> findById(@RequestParam(name = "resCompanyId") UUID resCompanyId) {
        ResCompany resCompany = resCompanyService.findById(resCompanyId);
        if (resCompany == null) {
            return ResponseHandler.generateResponseError("Res company not found", HttpStatus.NOT_FOUND);
        }
        return ResponseHandler.generateResponseSuccess("", resCompany);
    }

    @PostMapping("/update")
    public ResponseEntity<Object> update(@RequestBody ResCompanyUpdateDTO resCompanyUpdateDTO) {
        int count = resCompanyService.update(resCompanyUpdateDTO);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Failed to update res company", HttpStatus.BAD_REQUEST);
        }
        return ResponseHandler.generateResponseSuccess("Res company updated successfully", null);
    }

    @PostMapping("/delete")
    public ResponseEntity<Object> delete(@RequestParam(name = "resCompanyId") UUID resCompanyId) {
        int count = resCompanyService.deleteById(resCompanyId);
        if (count == 0) {
            return ResponseHandler.generateResponseError("Failed to delete res company", null);
        }
        return ResponseHandler.generateResponseSuccess("Res company deleted successfully", null);
    }
}
