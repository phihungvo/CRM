<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.base.admin.masterdata.mapper.DmNganhangMapper">
  <resultMap id="BaseResultMap" type="com.base.admin.masterdata.entity.DmNganhang">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="en" jdbcType="VARCHAR" property="en" />
    <result column="description" jdbcType="VARCHAR" property="description" />
    <result column="is_system" jdbcType="BIT" property="isSystem" />
    <result column="position" jdbcType="INTEGER" property="position" />
  </resultMap>
  <sql id="Base_Column_List">
    id, en, description, is_system, position
  </sql>

  <sql id="searchCondition">
    <if test="search != null">
      <if test="search.id != null"> and id = #{search.id,jdbcType=INTEGER}</if>
      <if test="search.en != null">
        <choose>
          <when test='exact == true'>
            and en = #{search.en}
          </when>
          <otherwise>
            and en ILIKE '%${search.en}%'
          </otherwise>
        </choose>
      </if>
      <if test="search.description != null">
        <choose>
          <when test='exact == true'>
            and description = #{search.description}
          </when>
          <otherwise>
            and description ILIKE '%${search.description}%'
          </otherwise>
        </choose>
      </if>
      <if test="search.position != null"> and position = #{search.position}</if>
      <if test="search.isSystem != null"> and is_system = #{search.isSystem}</if>
    </if>
  </sql>

  <sql id="pageable">
    <if test="pageable.sort.sorted">
      <trim prefix="order by">
        <foreach item="order" index="i" collection="pageable.sort" separator=", ">
          <if test="order.property == 'id'">id ${order.direction}</if>
          <if test="order.property == 'en'">en ${order.direction}</if>
          <if test="order.property == 'description'">description ${order.direction}</if>
          <if test="order.property == 'isSystem'">is_system ${order.direction}</if>
          <if test="order.property == 'position'">position ${order.direction}</if>
        </foreach>
      </trim>
    </if>
    <if test="pageable.paged">
      limit #{pageable.pageSize} offset #{pageable.offset}
    </if>
  </sql>

  <sql id="queryAndCountWhereStatement">
    <where>
      <include refid="searchCondition"></include>
    </where>
  </sql>

  <select id="countPaged" resultType="java.lang.Long">
    select count(1)
    from dm_nganhang
    <include refid="queryAndCountWhereStatement"/>
  </select>

<select id="searchPaged" resultType="com.base.admin.masterdata.entity.DmNganhang">
    select
    <include refid="Base_Column_List"/>
    from dm_nganhang
    <include refid="queryAndCountWhereStatement"/>
    <include refid="pageable"/>
  </select>

  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select 
    <include refid="Base_Column_List" />
    from dm_nganhang
    where id = #{id,jdbcType=INTEGER}
  </select>

  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from dm_nganhang
    where id = #{id,jdbcType=INTEGER}
  </delete>
  <insert id="insert" parameterType="com.base.admin.masterdata.entity.DmNganhang">
    <selectKey keyProperty="id" order="AFTER" resultType="java.lang.Integer">
      PostgreSQL
    </selectKey>
    insert into dm_nganhang (en, description, is_system, 
      position)
    values (#{en,jdbcType=VARCHAR}, #{description,jdbcType=VARCHAR}, #{isSystem,jdbcType=BIT}, 
      #{position,jdbcType=INTEGER})
  </insert>
  <update id="updateByPrimaryKey" parameterType="com.base.admin.masterdata.entity.DmNganhang">
    update dm_nganhang
    set en = #{en,jdbcType=VARCHAR},
      description = #{description,jdbcType=VARCHAR},
      is_system = #{isSystem,jdbcType=BIT},
      position = #{position,jdbcType=INTEGER}
    where id = #{id,jdbcType=INTEGER}
  </update>
</mapper>