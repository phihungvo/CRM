<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.base.admin.hrm.mapper.ContractTypeMapper">
  <resultMap id="BaseResultMap" type="com.base.admin.hrm.entity.ContractType">
    <id column="contracttypeid" jdbcType="INTEGER" property="contracttypeid" />
    <result column="contracttypename" jdbcType="VARCHAR" property="contracttypename" />
    <result column="position" jdbcType="INTEGER" property="position" />
    <result column="is_favorite" jdbcType="BOOLEAN" property="isFavorite" />
    <result column="is_system" jdbcType="BOOLEAN" property="isSystem" />
  </resultMap>
  <sql id="Base_Column_List">
    contracttypeid, contracttypename, "position", is_favorite, is_system
  </sql>

  <sql id="pageable">
    <if test="pageable.sort.sorted">
      <trim prefix="order by">
        <foreach item="order" index="i" collection="pageable.sort" separator=", ">
          <if test="order.property == 'contracttypeid'">contracttypeid ${order.direction}</if>
          <if test="order.property == 'contracttypename'">contracttypename ${order.direction}</if>
          <if test="order.property == 'position'">position ${order.direction}</if>
          <if test="order.property == 'isFavorite'">is_favorite ${order.direction}</if>
          <if test="order.property == 'isSystem'">is_system ${order.direction}</if>
        </foreach>
      </trim>
    </if>
    <if test="pageable.paged">
      limit #{pageable.pageSize} offset #{pageable.offset}
    </if>
  </sql>

  <select id="countPaged" resultType="long">
    select count(1)
    from contract_type
  </select>

  <select id="searchPaged" resultType="com.base.admin.hrm.entity.ContractType">
    select
    <include refid="Base_Column_List"/>
    from contract_type
    <include refid="pageable"/>
  </select>

  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select 
    <include refid="Base_Column_List" />
    from contract_type
    where contracttypeid = #{contracttypeid,jdbcType=INTEGER}
  </select>
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from contract_type
    where contracttypeid = #{contracttypeid,jdbcType=INTEGER}
  </delete>
  <insert id="insert" parameterType="com.base.admin.hrm.entity.ContractType">
    insert into contract_type (contracttypeid, contracttypename, 
      "position", is_favorite, is_system
      )
    values (#{contracttypeid,jdbcType=INTEGER}, #{contracttypename,jdbcType=VARCHAR}, 
      #{position,jdbcType=INTEGER}, #{isFavorite,jdbcType=BOOLEAN}, #{isSystem,jdbcType=BOOLEAN}
      )
  </insert>
  <insert id="insertSelective" parameterType="com.base.admin.hrm.entity.ContractType">
    insert into contract_type
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="contracttypeid != null">
        contracttypeid,
      </if>
      <if test="contracttypename != null">
        contracttypename,
      </if>
      <if test="position != null">
        "position",
      </if>
      <if test="isFavorite != null">
        is_favorite,
      </if>
      <if test="isSystem != null">
        is_system,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="contracttypeid != null">
        #{contracttypeid,jdbcType=INTEGER},
      </if>
      <if test="contracttypename != null">
        #{contracttypename,jdbcType=VARCHAR},
      </if>
      <if test="position != null">
        #{position,jdbcType=INTEGER},
      </if>
      <if test="isFavorite != null">
        #{isFavorite,jdbcType=BOOLEAN},
      </if>
      <if test="isSystem != null">
        #{isSystem,jdbcType=BOOLEAN},
      </if>
    </trim>
  </insert>
  <update id="updateByPrimaryKeySelective" parameterType="com.base.admin.hrm.entity.ContractType">
    update contract_type
    <set>
      <if test="contracttypename != null">
        contracttypename = #{contracttypename,jdbcType=VARCHAR},
      </if>
      <if test="position != null">
        "position" = #{position,jdbcType=INTEGER},
      </if>
      <if test="isFavorite != null">
        is_favorite = #{isFavorite,jdbcType=BOOLEAN},
      </if>
      <if test="isSystem != null">
        is_system = #{isSystem,jdbcType=BOOLEAN},
      </if>
    </set>
    where contracttypeid = #{contracttypeid,jdbcType=INTEGER}
  </update>
  <update id="updateByPrimaryKey" parameterType="com.base.admin.hrm.entity.ContractType">
    update contract_type
    set contracttypename = #{contracttypename,jdbcType=VARCHAR},
      "position" = #{position,jdbcType=INTEGER},
      is_favorite = #{isFavorite,jdbcType=BOOLEAN},
      is_system = #{isSystem,jdbcType=BOOLEAN}
    where contracttypeid = #{contracttypeid,jdbcType=INTEGER}
  </update>
</mapper>